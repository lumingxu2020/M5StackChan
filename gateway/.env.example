# Provider: openai | deepseek | minimax
STACKCHAN_LLM_PROVIDER=deepseek

# Optional. If omitted, each provider uses its default model.
# OpenAI: gpt-5.4-mini | DeepSeek: deepseek-chat | MiniMax: MiniMax-M3
STACKCHAN_LLM_MODEL=

# Keep provider keys on this Mac. Only the selected provider key is required.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=

# A separate local-network token used by StackChan when calling this Gateway.
STACKCHAN_GATEWAY_TOKEN=replace-with-a-long-random-token

# true returns a local deterministic response and never calls a model API.
STACKCHAN_MOCK_MODE=true

# safe: autonomous LLM/MCP calls cannot read private Mac data or change Mac state.
# custom: expose only the comma-separated names in STACKCHAN_AUTONOMOUS_ALLOWED_TOOLS.
# all: explicitly expose all 37 tools, including clipboard/calendar/control tools.
# Authenticated POST /v1/tools/{name} always retains the full tool inventory.
STACKCHAN_AUTONOMOUS_TOOL_MODE=safe
STACKCHAN_AUTONOMOUS_ALLOWED_TOOLS=

# Copy this WebSocket URL from StackChan World > Settings > MCP.
# It contains a secret token; keep it only in this local .env file.
XIAOZHI_MCP_ENDPOINT=
